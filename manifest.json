{
  "manifest_version": 3,
  "name": "[DNO_IT] VK Copy Post",
  "version": "3.1.5",
  "description": "Копирует посты ВК в HTML: значком 📋 после репоста или по клику на иконку расширения",
  "permissions": ["activeTab", "storage", "clipboardWrite", "alarms", "notifications"],
  "host_permissions": ["https://api.github.com/*"],
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.vk.com/*", "*://*.vk.ru/*"],
      "js": ["parser.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Скопировать первый пост",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  }
}
